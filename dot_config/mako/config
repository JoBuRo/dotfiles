anchor=top-right
max-visible=5
layer=overlay
margin=12,12,12
padding=12
width=360
height=120
border-size=2
border-radius=12
border-color=#89b4fa
background-color=#11111bee
text-color=#cdd6f4
default-timeout=5000
ignore-timeout=1
font=FiraCode Nerd Font 11
icons=1
max-icon-size=32
sort=-time
markup=1
actions=1
format=<b>%s</b>\n%b

[urgency=low]
border-color=#6c7086
default-timeout=3000

[urgency=normal]
border-color=#89b4fa
default-timeout=5000

[urgency=high]
border-color=#f38ba8
default-timeout=0
background-color=#1e1e2eff
text-color=#cdd6f4
