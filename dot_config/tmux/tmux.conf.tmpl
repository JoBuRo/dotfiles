{{- $profileName := get . "profile" | default "default" -}}
set -as terminal-features ",xterm-kitty*:RGB"
set -g allow-passthrough on
set -ga update-environment TERM
set -ga update-environment TERM_PROGRAM

unbind C-b
set -g prefix C-Space
bind C-Space send-prefix

bind -n M-H previous-window
bind -n M-L next-window

unbind '"'
unbind %
bind-key h split-window -h
bind-key v split-window -v

set -g mouse on

set -g history-limit 10000

set -g mode-keys vi

# One Dark theme
set -g status on
set -g status-interval 5
set -g status-position bottom
set -g status-style "bg=#1f2329,fg=#abb2bf"
set -g status-left-length 80
set -g status-right-length 120
set -g status-left "#[fg=#1f2329,bg=#61afef,bold] #S #[fg=#61afef,bg=#1f2329,nobold] "
set -g status-right "#[fg=#5c6370]#(whoami)@#H #[fg=#3e4451]| #[fg=#98c379]%Y-%m-%d #[fg=#61afef]%H:%M "
set -g message-style "bg=#2c313a,fg=#abb2bf"
set -g mode-style "bg=#61afef,fg=#1f2329,bold"
set -g pane-border-style "fg=#3e4451"
set -g pane-active-border-style "fg=#61afef"
set -g window-status-format "#[fg=#abb2bf,bg=#1f2329] #I:#W "
set -g window-status-current-format "#[fg=#1f2329,bg=#61afef,bold] #I:#W #[fg=#61afef,bg=#1f2329,nobold]"
set -g window-status-separator ""

# y and p as in vim, backed by the host system clipboard.
bind Escape copy-mode
unbind p
{{- if eq $profileName "wsl" }}
bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "clip.exe"
bind-key p run "powershell.exe -NoProfile -Command Get-Clipboard | tr -d '\r' | tmux load-buffer - ; tmux paste-buffer"
{{- else }}
bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "wl-copy"
bind-key p run "wl-paste -n | tmux load-buffer - ; tmux paste-buffer"
{{- end }}
bind-key -T copy-mode-vi v send-keys -X begin-selection
bind-key -T copy-mode-vi C-v send-keys -X rectangle-toggle

# Do not load .profile multiple times
set -g default-command "${SHELL}"

# List of plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'alexwforsythe/tmux-which-key'

# Other examples:
# set -g @plugin 'github_username/plugin_name'
# set -g @plugin 'github_username/plugin_name#branch'
# set -g @plugin 'git@github.com:user/plugin'
# set -g @plugin 'git@bitbucket.com:user/plugin'

# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run '~/.config/tmux/plugins/tpm/tpm'
