{{- $profileName := get . "profile" | default "default" -}}
{{- $profile := index .profiles $profileName -}}
{{- $opencode := get $profile "opencode" | default (dict) -}}
{
  "$schema": "https://opencode.ai/config.json",
  {{- with (get $opencode "model") }}
  "model": {{ . | quote }},
  {{- end }}
  {{- with (get $opencode "provider") }}
  "provider": {{ . | toJson }},
  {{- end }}
  "instructions": [
    "~/.agents/doctrine.md"
  ],
  "permission": {
    "question": "allow",
    "skill": {
      "contract-first-change": "allow",
      "tdd-workflow": "allow",
      "refactor-triage": "allow",
      "commit-policy": "allow"
    }
  },
  "default_agent": "Explore",
  "agent": {
    "build": {
      "mode": "primary",
      "temperature": 0.1,
      "prompt": "{file:./prompts/build.md}",
      "permission": {
        "question": "allow",
        "edit": "allow",
        "bash": "allow",
        "webfetch": "ask",
        "skill": {
          "*": "ask",
          "contract-first-change": "allow",
          "tdd-workflow": "allow",
          "refactor-triage": "allow",
          "commit-policy": "allow"
        }
      },
      "color": "accent"
    },
    "plan": {
      "disable": true
    },
    "explore": {
      "mode": "primary",
      "description": "Primary conversational agent for exploring ideas, approaches, and tradeoffs",
      "temperature": 0.6,
      "prompt": "{file:./prompts/explore.md}",
      "permission": {
        "question": "allow",
        "edit": "ask",
        "bash": "ask",
        "webfetch": "allow",
        "skill": {
          "contract-first-change": "allow",
          "refactor-triage": "allow"
        }
      },
      "color": "info"
    },
    "grug": {
      "mode": "primary",
      "description": "Simplicity-first primary agent for design feedback, complexity reduction, and smallest-next-step guidance",
      "temperature": 0.4,
      "prompt": "{file:./prompts/grug.md}",
      "permission": {
        "question": "allow",
        "edit": "ask",
        "bash": "ask",
        "webfetch": "allow",
        "skill": {
          "grug": "allow",
          "contract-first-change": "allow",
          "refactor-triage": "allow",
          "tdd-workflow": "ask"
        }
      },
      "color": "warning"
    }
  }
}
