{{- $profileName := get . "profile" | default "default" -}}
{{- $profile := index .profiles $profileName -}}
{{- $opencode := get $profile "opencode" | default (dict) -}}
{
  "$schema": "https://opencode.ai/config.json",
  {{- with (get $opencode "model") }}
  "model": {{ . | quote }},
  {{- end }}
  {{- with (get $opencode "provider") }}
  "provider": {{ . | toJson }},
  {{- end }}
  "instructions": [
    "~/.agents/doctrine.md"
  ],
  "permission": {
    "question": "allow",
    "edit": "deny",
    "task": "deny",
    "webfetch": "allow",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status --short": "allow",
      "pytest *": "allow",
      "pytest": "allow",
      "python -m pytest *": "allow",
      "python3 -m pytest *": "allow",
      "npm test": "allow",
      "npm test *": "allow",
      "npm run test": "allow",
      "npm run test *": "allow",
      "npm run lint": "allow",
      "npm run lint *": "allow",
      "cargo test": "allow",
      "cargo test *": "allow",
      "cargo check": "allow",
      "cargo check *": "allow",
      "go test *": "allow",
      "go vet *": "allow"
    },
    "skill": {
      "*": "ask",
      "change-workflow": "allow",
      "refactor-triage": "allow",
      "commit-policy": "allow",
      "grug": "allow",
      "customize-opencode": "allow"
    }
  },
  "default_agent": "investigate",
  "agent": {
    "plan": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  }
}
