{{ $profileName := get . "profile" | default "default" }}
{{ $profile := index .profiles $profileName }}
{{ $features := get $profile "features" | default (dict) }}
{{ $deps := get $profile "dependencies" | default (dict) }}
{{ $commands := get $deps "commands" | default (list) }}
{{ $byFeature := get $deps "byFeature" | default (dict) }}
{{ range $featureName, $featureDeps := $byFeature }}
{{ if (get $features $featureName | default false) }}
{{ $commands = concat $commands (get $featureDeps "commands" | default (list)) }}
{{ end }}
{{ end }}
{{ $usesTmux := false }}
{{ $usesNvim := false }}
{{ $usesVim := false }}
{{ $usesBottom := false }}
{{ $usesYazi := false }}
{{ $usesOpencode := false }}
{{ $usesKitty := false }}
{{ $usesFdfind := false }}
{{ $usesStarship := false }}
{{ $usesLsd := false }}
{{ $usesBat := false }}
{{ $usesBatcat := false }}
{{ range $commands }}
{{ if eq . "tmux" }}{{ $usesTmux = true }}{{ end }}
{{ if eq . "nvim" }}{{ $usesNvim = true }}{{ end }}
{{ if eq . "vim" }}{{ $usesVim = true }}{{ end }}
{{ if or (eq . "btm") (eq . "bottom") }}{{ $usesBottom = true }}{{ end }}
{{ if eq . "yazi" }}{{ $usesYazi = true }}{{ end }}
{{ if eq . "opencode" }}{{ $usesOpencode = true }}{{ end }}
{{ if eq . "kitty" }}{{ $usesKitty = true }}{{ end }}
{{ if eq . "fdfind" }}{{ $usesFdfind = true }}{{ end }}
{{ if eq . "starship" }}{{ $usesStarship = true }}{{ end }}
{{ if eq . "lsd" }}{{ $usesLsd = true }}{{ end }}
{{ if eq . "bat" }}{{ $usesBat = true }}{{ end }}
{{ if eq . "batcat" }}{{ $usesBatcat = true }}{{ end }}
{{ end }}
{{ $isRoot := eq .chezmoi.username "root" }}

{{ if not $usesTmux }}
.config/tmux
.config/tmux/**
{{ end }}

{{ if or $isRoot (not $usesNvim) }}
.config/nvim
.config/nvim/**
{{ end }}

{{ if not (or $isRoot $usesVim) }}
.vimrc
{{ end }}

{{ if not $usesBottom }}
.config/bottom
.config/bottom/**
{{ end }}

{{ if not $usesYazi }}
.config/yazi
.config/yazi/**
{{ end }}

{{ if not $usesOpencode }}
.config/opencode
.config/opencode/**
{{ end }}

{{ if not $usesKitty }}
.config/kitty
.config/kitty/**
{{ end }}

{{ if not $usesStarship }}
.config/starship.toml
{{ end }}

{{ if not $usesLsd }}
.config/lsd
.config/lsd/**
{{ end }}

{{ if not (or $usesBat $usesBatcat) }}
.config/bat
.config/bat/**
{{ end }}

{{ if not (or $usesFdfind $usesBatcat) }}
.local
.local/**
.local/bin/fd
.local/bin/bat
executable_dot_local
executable_dot_local/**
private_dot_local/bin/executable_fd
private_dot_local/bin/executable_bat
private_dot_local
private_dot_local/**
{{ end }}

{{ if and (or $usesFdfind $usesBatcat) (not $usesFdfind) }}
.local/bin/fd
private_dot_local/bin/executable_fd
{{ end }}

{{ if and (or $usesFdfind $usesBatcat) (not $usesBatcat) }}
.local/bin/bat
private_dot_local/bin/executable_bat
{{ end }}
