{{ $profileName := get . "profile" | default "default" }}
{{ $profile := index .profiles $profileName }}
{{ $features := get $profile "features" | default (dict) }}
{{ $deps := get $profile "dependencies" | default (dict) }}
{{ $commands := get $deps "commands" | default (list) }}
{{ $usesFdfind := false }}
{{ range $commands }}
{{ if eq . "fdfind" }}{{ $usesFdfind = true }}{{ end }}
{{ end }}
{{ $isRoot := eq .chezmoi.username "root" }}

{{ if not (get $features "tmux" | default false) }}
.config/tmux
.config/tmux/**
{{ end }}

{{ if or $isRoot (not (get $features "nvim" | default false)) }}
.config/nvim
.config/nvim/**
{{ end }}

{{ if not (or $isRoot (get $features "vim" | default false)) }}
.vimrc
{{ end }}

{{ if not (get $features "bottom" | default false) }}
.config/bottom
.config/bottom/**
{{ end }}

{{ if not (get $features "yazi" | default false) }}
.config/yazi
.config/yazi/**
{{ end }}

{{ if not (get $features "opencode" | default false) }}
.config/opencode
.config/opencode/**
{{ end }}

{{ if not (get $features "gui" | default false) }}
.config/kitty
.config/kitty/**
{{ end }}

{{ if not $usesFdfind }}
.local/bin/fd
{{ end }}
