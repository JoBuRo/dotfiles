" Slim Vim configuration for minimal nodes.
" Mirrors the day-to-day LazyVim defaults without loading plugins.

if exists('g:loaded_slim_vimrc')
  finish
endif
let g:loaded_slim_vimrc = 1

set nocompatible
let mapleader = ' '
let maplocalleader = ' '

" Core editing behavior: close to LazyVim's defaults, cheap in plain Vim.
set encoding=utf-8
set fileencoding=utf-8
set number
set norelativenumber
if exists('&signcolumn')
  set signcolumn=yes
endif
set cursorline
set mouse=a
set hidden
set splitbelow
set splitright
set scrolloff=4
set sidescrolloff=8
set nowrap
set linebreak
set showmode
set showcmd
set laststatus=2
set ruler
set wildmenu
set wildmode=longest:full,full
set wildignore+=*/.git/*,*/node_modules/*,*/target/*,*/dist/*,*/build/*,*.pyc
set path+=**
set completeopt=menu,menuone,noselect
set ignorecase
set smartcase
set incsearch
set hlsearch
set tabstop=2
set softtabstop=2
set shiftwidth=2
set expandtab
set smartindent
set autoindent
set updatetime=200
set timeoutlen=300
if exists('&undofile')
  set undofile
endif
set history=200
set list
set listchars=tab:»\ ,trail:·,nbsp:␣

if exists('&inccommand')
  set inccommand=nosplit
endif

if exists('&termguicolors')
  set termguicolors
endif

if has('clipboard')
  if has('unnamedplus')
    set clipboard=unnamedplus
  else
    set clipboard=unnamed
  endif
endif

if executable('rg')
  set grepprg=rg\ --vimgrep\ --smart-case\ --hidden\ --glob\ !.git
  set grepformat=%f:%l:%c:%m
endif

if has('syntax')
  syntax enable
endif
filetype plugin indent on

" Plugin-free file explorer defaults, standing in for LazyVim's explorer.
let g:netrw_banner = 0
let g:netrw_liststyle = 3
let g:netrw_browse_split = 0
let g:netrw_altv = 1
let g:netrw_winsize = 25

" A tiny OneDark-darker inspired palette without a colorscheme plugin.
set background=dark
function! s:SlimHighlight(group, guifg, guibg, ctermfg, ctermbg, attrs) abort
  let l:command = 'highlight ' . a:group
  let l:command .= ' guifg=' . a:guifg . ' guibg=' . a:guibg
  let l:command .= ' ctermfg=' . a:ctermfg . ' ctermbg=' . a:ctermbg
  let l:command .= ' gui=' . a:attrs . ' cterm=' . a:attrs
  execute l:command
endfunction

