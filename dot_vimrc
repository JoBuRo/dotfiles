" LazyVim-like leader shortcuts using built-in Vim commands.
nnoremap <silent> <leader>w :write<CR>
nnoremap <silent> <leader>q :quit<CR>
nnoremap <silent> <leader>e :Explore<CR>
nnoremap <silent> <leader>E :Lexplore<CR>
nnoremap <leader>ff :find **/*
nnoremap <leader>fb :buffers<CR>:buffer<Space>
nnoremap <silent> <leader>xx :copen<CR>
nnoremap <silent> <leader>xq :cclose<CR>
nnoremap <silent> <Esc> :nohlsearch<CR><Esc>
nnoremap Y y$

function! s:GrepProject() abort
  let l:pattern = input('Grep > ')
  if empty(l:pattern)
    return
  endif
  if executable('rg')
    silent execute 'grep! ' . shellescape(l:pattern)
  else
    silent! execute 'vimgrep /' . escape(l:pattern, '/\') . '/gj **/*'
  endif
  botright copen
endfunction
nnoremap <silent> <leader>sg :call <SID>GrepProject()<CR>

function! s:GrepWordUnderCursor() abort
  let l:pattern = expand('<cword>')
  if empty(l:pattern)
    return
  endif
  if executable('rg')
    silent execute 'grep! ' . shellescape(l:pattern)
  else
    silent! execute 'vimgrep /\V' . escape(l:pattern, '/\') . '/gj **/*'
  endif
  botright copen
endfunction
nnoremap <silent> <leader>/ :call <SID>GrepWordUnderCursor()<CR>

" Lightweight stand-in for the Markview split-preview key in Neovim.
function! s:ToggleMarkdownReadingMode() abort
  if &l:wrap
    setlocal nowrap nospell conceallevel=0
  else
    setlocal wrap linebreak spell conceallevel=2
  endif
endfunction
nnoremap <silent> <leader>cp :call <SID>ToggleMarkdownReadingMode()<CR>

" Split navigation, with tmux handoff when Vim is inside tmux.
function! s:Tmux(command) abort
  if exists('$TMUX') && executable('tmux')
    silent call system('tmux ' . a:command)
  endif
endfunction

function! s:NavigateSplit(vim_direction, tmux_direction) abort
  let l:current_window = winnr()
  execute 'wincmd ' . a:vim_direction
  if winnr() == l:current_window && exists('$TMUX') && executable('tmux')
    silent call system('tmux select-pane -' . a:tmux_direction)
  endif
endfunction

function! s:NavigateLastSplitOrTmux() abort
  let l:current_window = winnr()
  wincmd p
  if winnr() == l:current_window
    call s:Tmux('last-pane')
  endif
endfunction

function! s:NavigateNextSplitOrTmux() abort
  let l:current_window = winnr()
  wincmd w
  if winnr() == l:current_window
    call s:Tmux('select-pane -t :.+')
  endif
endfunction

nnoremap <silent> <C-h> :call <SID>NavigateSplit('h', 'L')<CR>
nnoremap <silent> <C-j> :call <SID>NavigateSplit('j', 'D')<CR>
nnoremap <silent> <C-k> :call <SID>NavigateSplit('k', 'U')<CR>
nnoremap <silent> <C-l> :call <SID>NavigateSplit('l', 'R')<CR>
nnoremap <silent> <C-\> :call <SID>NavigateLastSplitOrTmux()<CR>
nnoremap <silent> <C-Space> :call <SID>NavigateNextSplitOrTmux()<CR>
nnoremap <silent> <Nul> :call <SID>NavigateNextSplitOrTmux()<CR>

augroup slim_vim
  autocmd!
  autocmd FileType markdown,text,gitcommit setlocal wrap linebreak spell
  autocmd FileType markdown setlocal conceallevel=2
  autocmd FileType json setlocal conceallevel=0
  autocmd FileType python setlocal tabstop=4 softtabstop=4 shiftwidth=4 expandtab
  autocmd FileType make setlocal noexpandtab
augroup END
